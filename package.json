{
  "name": "hotkeypad",
  "version": "1.0.2",
  "description": "HotKeyPad: A simple and beautiful command keyboard shortcut for your web app.",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "type": "module",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "docs/hotkeypad-demo.gif",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./*.css": "./dist/styles/*.css"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/build.mjs && node --test",
    "test:package": "node scripts/check-package.mjs",
    "prepack": "node scripts/build.mjs"
  },
  "keywords": [
    "hotkey",
    "keyboard",
    "shortcut",
    "command"
  ],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/jesubohr/hotkeypad.git"
  },
  "homepage": "https://github.com/jesubohr/hotkeypad#readme",
  "author": "Jesus Borrero (jesubohr)",
  "license": "MIT",
  "devDependencies": {
    "jsdom": "26.1.0",
    "typescript": "5.3.3"
  }
}
